        <zone flipboard-zone-id='5' h='9855' hidden='true' id='18' story-point-id='5' type-v2='text' w='68504' x='2362' y='72407'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#598abe' fontname='Arial' fontsize='16'>This analysis compares loan amounts across different states or regions.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='18568' hidden='true' id='19' story-point-id='6' type-v2='text' w='33268' x='66043' y='46888'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#598abe' fontname='Arial' fontsize='16'>This section identifies which payment methods contribute the highest EMI collections.</run>
