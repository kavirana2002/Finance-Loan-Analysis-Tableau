      <column caption='customer_risk_categories' datatype='string' name='[Calculation_1279284999438345]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [credit_score] &lt;=650&#13;&#10;AND [remaining_balance] &gt; 500000&#13;&#10;AND [loan_status] = &quot;Default&quot;&#13;&#10;AND [late_fee] &gt;5000&#13;&#10;THEN &quot;High Risk&quot;&#13;&#10;&#13;&#10;ELSEIF [credit_score]&lt;=730&#13;&#10;OR [late_fee] &gt; 2000&#13;&#10;THEN &quot;Medium Risk&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
