      <column caption='RISK' datatype='string' name='[Calculation_0906276376600576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [credit_score]&lt;=650 THEN &quot;HIGH RISK&quot;&#13;&#10;ELSEIF [credit_score]&lt;=750 THEN &quot;MEDIUM RISK&quot;&#13;&#10;ELSE &quot;LOW RISK&quot;&#13;&#10;END' />
      </column>
      <column caption='Risk Categories' datatype='string' name='[Calculation_0921669894918144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [credit_score] &lt; 650&#13;&#10;or [remaining_balance] &gt; 3233199&#13;&#10;or [loan_status] = &quot;Default&quot;&#13;&#10;or [late_fee] &gt;=501&#13;&#10;THEN &quot;High Risk&quot;&#13;&#10;&#13;&#10;ELSEIF [credit_score] &gt;= 650 &#13;&#10;AND [credit_score] &lt; 750&#13;&#10;OR ([remaining_balance] &gt;= 1616600&#13;&#10;AND [remaining_balance] &lt;= 3233198)&#13;&#10;OR [loan_status] = &quot;Active&quot;&#13;&#10;OR ([late_fee] &gt; 0 AND [late_fee] &lt;= 500)&#13;&#10;THEN &quot;Medium Risk&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='Total_customers' datatype='integer' name='[Calculation_1279284996546561]' role='measure' type='quantitative'>
