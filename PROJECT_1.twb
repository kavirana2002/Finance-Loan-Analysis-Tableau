        <zone flipboard-zone-id='5' forceUpdate='true' h='10062' hidden='true' id='13' story-point-id='15' type-v2='text' w='93307' x='2854' y='33091'>
          <formatted-text>
            <run fontalignment='0' fontcolor='#598abe' fontname='Arial' fontsize='16'>This section provides an overview of customer count, loan distribution, EMI collection, and remaining balances.</run>
