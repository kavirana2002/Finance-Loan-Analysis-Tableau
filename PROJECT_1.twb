    <worksheet name='Q8'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Arial Black' fontsize='10' italic='true'>Risk Categories</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Multiple Connections' name='federated.1n4m4ry0ox1mp01ay2dic1u16jj6' />
          </datasources>
          <datasource-dependencies datasource='federated.1n4m4ry0ox1mp01ay2dic1u16jj6'>
            <column caption='count_customer_id' datatype='integer' name='[Calculation_0100059135356928]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([customer_id])' />
            </column>
            <column caption='Risk Categories' datatype='string' name='[Calculation_0921669894918144]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [credit_score] &lt; 650&#13;&#10;or [remaining_balance] &gt; 3233199&#13;&#10;or [loan_status] = &quot;Default&quot;&#13;&#10;or [late_fee] &gt;=501&#13;&#10;THEN &quot;High Risk&quot;&#13;&#10;&#13;&#10;ELSEIF [credit_score] &gt;= 650 &#13;&#10;AND [credit_score] &lt; 750&#13;&#10;OR ([remaining_balance] &gt;= 1616600&#13;&#10;AND [remaining_balance] &lt;= 3233198)&#13;&#10;OR [loan_status] = &quot;Active&quot;&#13;&#10;OR ([late_fee] &gt; 0 AND [late_fee] &lt;= 500)&#13;&#10;THEN &quot;Medium Risk&quot;&#13;&#10;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
            </column>
            <column caption='Credit Score' datatype='integer' name='[credit_score]' role='measure' type='quantitative' />
            <column caption='Customer Id' datatype='string' name='[customer_id]' role='dimension' type='nominal' />
            <column caption='Late Fee' datatype='integer' name='[late_fee]' role='measure' type='quantitative' />
            <column caption='Loan Status' datatype='string' name='[loan_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0921669894918144]' derivation='None' name='[none:Calculation_0921669894918144:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[remaining_balance]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0100059135356928]' derivation='User' name='[usr:Calculation_0100059135356928:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.1n4m4ry0ox1mp01ay2dic1u16jj6].[none:Calculation_0921669894918144:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;High Risk&quot;</bucket>
              <bucket>&quot;Medium Risk&quot;</bucket>
              <bucket>&quot;Low Risk&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='size-bar' field='[federated.1n4m4ry0ox1mp01ay2dic1u16jj6].[usr:Calculation_0100059135356928:qk]' field-type='quantitative' max-size='1' min-size='0.005' type='centersize' />
          </style-rule>
