          <formatted-text>
            <run fontalignment='0' fontcolor='#598abe' fontname='Arial' fontsize='16'>This trend analysis shows monthly fluctuations in loan approvals over time.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='20851' hidden='true' id='16' story-point-id='4' type-v2='text' w='24213' x='74705' y='41909'>
